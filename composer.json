{
    "name": "chrono-meter/composer-plugin-for-wp",
    "description": "Composer plugin for WordPress plugins and themes.",
    "version": "1.1.2",
    "type": "composer-plugin",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "ChronoMeter\\ComposerPluginForWp\\": "src/"
        }
    },
    "authors": [
        {
            "name": "chrono-meter",
            "email": "chrono-meter@gmx.net"
        }
    ],
    "require": {
        "php": "^8.2",
        "composer-plugin-api": "^2.0",
        "symfony/filesystem": "^8.0"
    },
    "require-dev": {
        "composer/composer": "^2.0"
    },
    "extra": {
        "class": "ChronoMeter\\ComposerPluginForWp\\Plugin"
    }
}
